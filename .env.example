# Copy to .env and fill in. Never commit .env.

# --- Google Earth Engine ---
# Cloud project registered for Earth Engine (noncommercial use).
EE_PROJECT=
# Optional: path to a service-account JSON key (leave empty to use
# `earthengine authenticate` user credentials instead).
EE_SERVICE_ACCOUNT_KEY=
# Or the key file's whole JSON content (used on the hosted demo, set as a secret there).
EE_SERVICE_ACCOUNT_JSON=

# --- Explanations (optional) ---
# If empty, the app falls back to template-based explanations.
ANTHROPIC_API_KEY=
# Optional; default claude-opus-5-5
ANTHROPIC_MODEL=

# --- Backend ---
CACHE_PATH=backend/cache.sqlite
# Coordinate rounding for the cache key, in degrees.
CACHE_GRID_DEG=0.05
